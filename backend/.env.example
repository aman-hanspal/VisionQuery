# Auto selects CUDA, MPS, or CPU. On an NVIDIA laptop, set cuda explicitly
# after installing a CUDA-enabled PyTorch build and verifying CUDA availability.
DEVICE=auto
MODEL_PATH=yolov8m-worldv2.pt
INFERENCE_IMAGE_SIZE=640
STORAGE_DIR=storage/videos
RUNS_DIR=storage/runs
MAX_CLASSES=10
# Default for budget mode only (full mode has no implicit frame cutoff).
MAX_SAMPLED_FRAMES=900
# Returned/stored box limit only: scanning continues after reaching it.
MAX_DETECTIONS=5000
MAX_UPLOAD_BYTES=1073741824
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional: without this, use comma-separated object phrases.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
